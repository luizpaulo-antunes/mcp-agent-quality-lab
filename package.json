{
  "name": "mcp-agent-quality-lab",
  "version": "0.1.0",
  "description": "A sanitized TypeScript portfolio project for testing an MCP-enabled AI support agent.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "mcp": "tsx src/mcp/stdio-server.ts",
    "demo:claude": "tsx src/agent/run-claude-mcp.ts",
    "check": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:eval": "vitest run tests/evals",
    "test:api": "playwright test tests/api",
    "test:e2e": "playwright test tests/e2e",
    "test": "npm run check && npm run test:unit && npm run test:eval && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ajv": "^8.20.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
